(ns indprod.render-html
  "Build-time HTML renderer for `docs/samples/operator-console.html`.

  This repo had NO demo/visualization at all before this namespace.
  This drives the REAL actor stack (`indprod.actor` ->
  `indprod.governor` -> `indprod.store`) through a scenario built from
  real, exercised store/test data and renders the result
  deterministically -- no invented numbers, no timestamps in the page
  content, byte-identical across reruns against the same seed (verify
  by diffing two consecutive runs before shipping). Adapted from the
  reference pattern in `cloud-itonami-isco-1211`'s
  `finmgmt.render-html` (com-junkawasaki/root, prior iteration of this
  same effort) -- the entities/rules below are specific to this
  domain, not copied verbatim.

  `client-1` (\"Kobo Trade\") + process `P-1` (\"shaft-turning\", LSL
  9.95 / USL 10.05, allowable stack 0.30) are lifted VERBATIM from this
  repo's own proven-passing test fixture
  (`indprod.actor-test/fresh-store` and
  `indprod.governor-test/fresh-store`, identical seed in both). The
  in-tolerance measurement (10.0), the two inclusive band-edge
  measurements (9.95 and 10.05, from
  `governor-test/ok-at-exact-band-edges`), the two out-of-tolerance
  measurements (9.90 and 10.10), the in-allowable stack-up (0.25) and
  the over-allowable stack-up (0.35) are all copied VERBATIM from
  `indprod.governor-test`'s own assertions -- ground truth, not
  invented. `client-2` (\"Other\") is also lifted VERBATIM from
  `indprod.governor-test/hard-on-foreign-process`'s own fixture (that
  test registers exactly this client, with exactly this name, to prove
  `:process-wrong-client`).

  Process `P-2` (\"housing-bore\", LSL 24.9 / USL 25.1, allowable stack
  0.40) for `client-2` is ADDITIONAL demo data registered via the SAME
  real protocol call (`store/register-process!`) this actor's own
  tests use -- `client-2` has no process of its own in the original
  test fixture (it exists there only to prove the cross-client
  rejection), so a second process is registered here purely to show
  that `client-2` can also complete a normal, in-tolerance measurement
  through the real graph. Disclosed here plainly, not presented as a
  pre-existing fixture. Every other field this page displays
  (statuses, dispositions, hold reasons) is real output read after
  `run-demo!` actually executed the graph -- none of it is hand-typed.

  Known architectural gap, honestly noted rather than papered over
  (mirrors the exact same shape as `finmgmt`'s `:no-actuation` gap):

  1. `indprod.governor`'s `:no-actuation` rule (proposal `:effect` must
     be `:propose`) is NOT reachable through this demo, because the
     real `mock-advisor` (`indprod.advisor/infer`) unconditionally
     sets `:effect :propose` on every proposal it emits. Covered
     instead by
     `indprod.governor-test/hard-on-no-actuation-violation`, which
     calls `governor/check` directly with a hand-built proposal.
  2. The low-confidence escalation path (`confidence <
     indprod.governor/confidence-floor`, 0.6) is likewise NOT reachable
     through this demo: `indprod.advisor/infer` maps `:stake` to a
     fixed confidence of 0.7/0.85/0.95 (`:high`/`:medium`/`:low`),
     never below the floor. Covered instead by
     `indprod.governor-test/escalates-low-confidence`, which also
     calls `governor/check` directly. The only escalation this demo
     genuinely reaches through the real advisor is
     `:approve-deviation` (always human-approved regardless of
     confidence).

  Usage: `kbb -M:render-html [out-file]`
  (default `docs/samples/operator-console.html`)."
  (:require [jp-go-dds.skin]
            [kotoba.lang.text :as str]
            [indprod.store :as store]
            [indprod.actor :as actor]))

;; ----------------------------- harness --------------------------------

(defn- run-op!
  "Drives one real manufacturing QA request through the actual compiled
  graph for `tid` (thread-id). If the graph escalates (interrupts
  before `:request-approval`), immediately approves it -- this demo's
  scenario never demonstrates an UNAPPROVED escalation, every
  escalation here reaches a human who signs off. Returns a map
  describing exactly what really happened -- no field is invented."
  [graph tid client-id op extra]
  (let [request (merge {:client-id client-id :op op} extra)
        r1 (actor/run-request! graph request {} tid)]
    (if (= :interrupted (:status r1))
      (let [r2 (actor/approve! graph tid)]
        {:thread-id tid :client-id client-id :op op :request request
         :outcome :approved-and-committed
         :record (get-in r2 [:state :record])})
      (let [disposition (get-in r1 [:state :disposition])]
        (if (= :hold disposition)
          {:thread-id tid :client-id client-id :op op :request request
           :outcome :hard-hold
           :verdict (get-in r1 [:state :verdict])
           :rule (-> r1 :state :verdict :violations first :rule)}
          {:thread-id tid :client-id client-id :op op :request request
           :outcome :auto-committed
           :record (get-in r1 [:state :record])})))))

(def ^:private op-specs
  "The scenario: covers every disposition this actor can genuinely
  reach through its real graph (auto-commit, escalate-then-approve,
  and all 5 of the 6 distinct HARD-hold rules in `indprod.governor`
  that are reachable via the real advisor -- `:no-actuation` and the
  low-confidence escalation path are structurally unreachable, see
  namespace docstring). Every `:op` keyword and violation rule name
  below is copied from `indprod.governor`'s own `hard-violations`/
  `check`, not invented."
  [;; client-1 / \"Kobo Trade\" / P-1 (\"shaft-turning\", LSL 9.95 /
   ;; USL 10.05, allowable stack 0.30) -- real fixture from
   ;; indprod.actor-test / indprod.governor-test
   ["c1-measure-ok"        "client-1" :approve-measurement {:process-id "P-1" :measured 10.0 :stake :low}]
   ["c1-measure-edge-lsl"  "client-1" :approve-measurement {:process-id "P-1" :measured 9.95 :stake :low}]
   ["c1-measure-edge-usl"  "client-1" :approve-measurement {:process-id "P-1" :measured 10.05 :stake :low}]
   ["c1-measure-below-lsl" "client-1" :approve-measurement {:process-id "P-1" :measured 9.90 :stake :low}]
   ["c1-measure-above-usl" "client-1" :approve-measurement {:process-id "P-1" :measured 10.10 :stake :low}]
   ["c1-stackup-ok"        "client-1" :approve-stackup {:process-id "P-1" :stack 0.25 :stake :low}]
   ["c1-stackup-exceeds"   "client-1" :approve-stackup {:process-id "P-1" :stack 0.35 :stake :low}]
   ["c1-unknown-process"   "client-1" :approve-measurement {:process-id "P-ghost" :measured 10.0 :stake :low}]
   ["c1-deviation"         "client-1" :approve-deviation {:process-id "P-1" :stake :high}]
   ;; unregistered client entirely
   ["ghost-no-client"      "client-ghost" :approve-measurement {:process-id "P-1" :measured 10.0 :stake :low}]
   ;; client-2 / \"Other\" (real fixture name from
   ;; indprod.governor-test/hard-on-foreign-process) citing client-1's
   ;; process -- cross-client rejection
   ["c2-wrong-process"     "client-2" :approve-measurement {:process-id "P-1" :measured 10.0 :stake :low}]
   ;; client-2's OWN process P-2 (additional demo data, registered via
   ;; the same real register-process! call -- see namespace docstring)
   ["c2-measure-ok"        "client-2" :approve-measurement {:process-id "P-2" :measured 25.0 :stake :low}]])

(defn run-demo!
  "Runs a fresh store through `op-specs` (see above) via the real
  compiled `indprod.actor` graph. Returns `{:store :runs}` -- `:runs`
  is the ordered vector of real per-request outcomes; every field in
  `render` below is read from this or from `store` after the graph
  actually executed, never hand-typed."
  []
  (let [db (store/mem-store)]
    (store/register-client! db {:client-id "client-1" :name "Kobo Trade"})
    (store/register-process! db {:process-id "P-1" :client-id "client-1"
                                 :name "shaft-turning" :lsl 9.95 :usl 10.05
                                 :allowable-stack 0.30})
    (store/register-client! db {:client-id "client-2" :name "Other"})
    (store/register-process! db {:process-id "P-2" :client-id "client-2"
                                 :name "housing-bore" :lsl 24.9 :usl 25.1
                                 :allowable-stack 0.40})
    (let [graph (actor/build-graph {:store db})
          runs (mapv (fn [[tid client-id op extra]]
                       (run-op! graph tid client-id op extra))
                     op-specs)]
      {:store db :runs runs})))

;; ----------------------------- rendering -------------------------------

(defn- esc [v]
  (-> (str v)
      (str/replace "&" "&amp;")
      (str/replace "<" "&lt;")
      (str/replace ">" "&gt;")))

(defn- outcome-cell [{:keys [outcome rule]}]
  (case outcome
    :auto-committed "<span class=\"ok\">committed</span>"
    :approved-and-committed "<span class=\"ok\">approved &amp; committed</span>"
    :hard-hold (str "<span class=\"critical\">HARD hold &middot; " (esc (name (or rule :unknown))) "</span>")
    "<span class=\"muted\">in progress</span>"))

(defn- client-row [store {:keys [client-id name]} runs]
  (let [committed (count (store/records-of store client-id))
        client-runs (filter #(= client-id (:client-id %)) runs)]
    (format "        <tr><td>%s</td><td>%s</td><td>%d</td><td>%d</td></tr>"
            (esc client-id) (esc name) committed (count client-runs))))

(defn- process-row [store {:keys [process-id]}]
  (let [p (store/process store process-id)]
    (format "        <tr><td><code>%s</code></td><td>%s</td><td>%s</td><td>%.2f&ndash;%.2f</td><td>%.2f</td></tr>"
            (esc process-id) (esc (:client-id p)) (esc (:name p)) (:lsl p) (:usl p) (:allowable-stack p))))

(defn- run-row [{:keys [thread-id client-id op request outcome rule]}]
  (format "        <tr><td><code>%s</code></td><td>%s</td><td><code>%s</code></td><td>%s</td><td>%s</td><td>%s</td></tr>"
          (esc thread-id) (esc client-id) (esc (name op))
          (esc (or (:process-id request) ""))
          (esc (or (some-> (:measured request) str)
                    (some-> (:stack request) str)
                    ""))
          (outcome-cell {:outcome outcome :rule rule})))

(def ^:private action-gate-rows
  ;; Static description of this actor's own op contract (README.md,
  ;; `indprod.governor`'s own docstring) -- documentation of fixed
  ;; behavior, not runtime telemetry, so it is legitimately
  ;; hand-described rather than derived from a live run.
  ["        <tr><td><code>:approve-measurement</code></td><td><span class=\"warn\">HARD hold unless LSL &le; measured &le; USL &middot; interval containment is arithmetic, not judgement</span></td></tr>"
   "        <tr><td><code>:approve-stackup</code></td><td><span class=\"warn\">HARD hold if cumulative tolerance exceeds the process's registered allowable stack &middot; a stack either fits or it doesn't</span></td></tr>"
   "        <tr><td><code>:approve-deviation</code></td><td><span class=\"warn\">ALWAYS human approval &middot; accepting an out-of-spec part or over-stack assembly anyway</span></td></tr>"])

(defn render
  "Renders the full operator-console.html document from `{:store :runs}`
  as produced by `run-demo!` (or any other real scenario)."
  [{:keys [store runs]}]
  (let [clients [{:client-id "client-1" :name "Kobo Trade"}
                 {:client-id "client-2" :name "Other"}]
        processes [{:process-id "P-1"} {:process-id "P-2"}]
        client-rows (str/join "\n" (map #(client-row store % runs) clients))
        process-rows (str/join "\n" (map #(process-row store %) processes))
        run-rows (str/join "\n" (map run-row runs))]
    (str
     "<html><head><meta charset=\"utf-8\"><title>cloud-itonami-isco-2141 &middot; community industrial and production engineering</title><style>"
   (jp-go-dds.skin/dds+skin)
   "</style></head><body>\n"
     "<header class=\"bar\">\n"
     "  <h1>Community Industrial &amp; Production Engineering (ISCO-08 2141) — Operator Console</h1>\n"
     "  <span class=\"badge\">read-only sample · governor-gated · tolerance containment &amp; stack-up sums checked by arithmetic, never judgement</span>\n"
     "</header>\n"
     "<main>\n"
     "  <section class=\"card\">\n"
     "    <h2>Registered clients</h2>\n"
     "    <p class=\"muted\">Demo snapshot — build-time-generated from <code>indprod.store</code> via <code>indprod.render-html</code> (<code>kbb -M:render-html</code>), regenerated nightly.</p>\n"
     "    <table>\n"
     "      <thead><tr><th>Client</th><th>Name</th><th>Committed records</th><th>Requests this run</th></tr></thead>\n"
     "      <tbody>\n"
     client-rows "\n"
     "      </tbody>\n"
     "    </table>\n"
     "  </section>\n"
     "  <section class=\"card\">\n"
     "    <h2>Registered processes &amp; tolerance bands</h2>\n"
     "    <p class=\"muted\">LSL/USL is the registered tolerance band for a single dimension (inclusive at both edges); allowable stack is the registered maximum cumulative tolerance for an assembly of steps citing this process.</p>\n"
     "    <table>\n"
     "      <thead><tr><th>Process</th><th>Client</th><th>Name</th><th>LSL&ndash;USL</th><th>Allowable stack</th></tr></thead>\n"
     "      <tbody>\n"
     process-rows "\n"
     "      </tbody>\n"
     "    </table>\n"
     "  </section>\n"
     "  <section class=\"card\">\n"
     "    <h2>Action gate (Industrial &amp; Production Engineers Governor)</h2>\n"
     "    <p class=\"muted\">HARD holds cannot be overridden. Tolerance containment and stack-up sums are checked by arithmetic on every proposal, at any confidence.</p>\n"
     "    <table>\n"
     "      <thead><tr><th>Op</th><th>Gate</th></tr></thead>\n"
     "      <tbody>\n"
     (str/join "\n" action-gate-rows) "\n"
     "      </tbody>\n"
     "    </table>\n"
     "  </section>\n"
     "  <section class=\"card\">\n"
     "    <h2>Audit trail (this run)</h2>\n"
     "    <p class=\"muted\">Every request this scenario drove through the real compiled graph, in order — thread-id, client, op, the request's own cited process and measured/stack value, and the real disposition (auto-commit, approved-after-escalation, or the specific HARD-hold rule).</p>\n"
     "    <table>\n"
     "      <thead><tr><th>Thread</th><th>Client</th><th>Op</th><th>Process</th><th>Measured/stack</th><th>Disposition</th></tr></thead>\n"
     "      <tbody>\n"
     run-rows "\n"
     "      </tbody>\n"
     "    </table>\n"
     "  </section>\n"
     "</main>\n"
     "</body></html>\n")))

(defn -main [& args]
  (let [out (or (first args) "docs/samples/operator-console.html")
        result (run-demo!)
        html (render result)]
    (spit out html)
    (println "wrote" out "("
             (count (:runs result)) "requests driven through the real graph,"
             (count (store/ledger (:store result))) "ledger facts )")))
